+VkPipeline VulkanPipelineCache::GetComputePipeline(
+    VulkanShader::VulkanTranslation* compute_shader, VkPipelineLayout pipeline_layout) {
+  if (!compute_shader || pipeline_layout == VK_NULL_HANDLE) {
+    return VK_NULL_HANDLE;
+  }
+  ComputePipelineKey key{compute_shader, pipeline_layout};
+  auto it = compute_pipelines_.find(key);
+  if (it != compute_pipelines_.end()) {
+    return it->second;
+  }
+  VkShaderModule module = compute_shader->GetOrCreateShaderModule();
+  if (module == VK_NULL_HANDLE) {
+    compute_pipelines_.emplace(key, VK_NULL_HANDLE);
+    return VK_NULL_HANDLE;
+  }
+  VkPipeline pipeline = ui::vulkan::util::CreateComputePipeline(
+      command_processor_.GetVulkanDevice(), pipeline_layout, module);
+  compute_pipelines_.emplace(key, pipeline);
+  return pipeline;
+}
